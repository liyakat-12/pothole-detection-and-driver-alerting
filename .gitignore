# ============================================================
# Root .gitignore for the whole project (ai/ + website/)
# ============================================================

# ----- OS -----
.DS_Store
Thumbs.db
desktop.ini
ehthumbs.db

# ----- Node / frontend / backend -----
node_modules/
dist/
dist-ssr/
build/
.cache/
*.local

# Locally-stored media fallback (user uploads kept on disk)
uploads/
**/uploads/

# ----- Environment variables / secrets -----
.env
.env.local
.env.*.local
*.pem

# ----- Python -----
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
.ipynb_checkpoints/
.venv/
venv/
env/
ENV/
.pytest_cache/

# ----- Editors / IDEs -----
.vscode/
.idea/
*.swp
*.swo
*~

# ----- Logs & temp -----
*.log
logs/
tmp/
temp/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
tempCodeRunnerFile.py

# ============================================================
# Datasets 
# ============================================================
ai/dataset_rdd/
**/dataset_rdd/
*.zip
*.tar
*.tar.gz
*.tgz
*.rar
*.7z

# ----- Base / pretrained weights (auto-downloaded, no need to commit) -----
ai/yolov8s.pt
ai/yolov8n.pt
ai/yolo11n.pt
ai/yolov8m.pt
ai/yolov8l.pt
ai/yolov8x.pt

# ----- Training/prediction runs -----
# Ignore everything under ai/runs (sample videos, predict outputs, training
# batches, optimizer checkpoints) EXCEPT the trained model the website needs.
ai/runs/**
!ai/runs/
!ai/runs/detect/
!ai/runs/detect/train2/
!ai/runs/detect/train2/weights/
!ai/runs/detect/train2/weights/best.pt

**/*.cache
*.avi
